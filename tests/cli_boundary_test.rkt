#lang racket/base
(require rackunit racket/port racket/runtime-path racket/list json "../main.rkt"
         (prefix-in cli: "../bin/cli.rkt"))
(define-runtime-path cli "../bin/cli.rkt")
(define (run-cli arguments input)
  (define-values (child stdout stdin stderr)
    (apply subprocess #f #f #f (find-system-path 'exec-file) cli arguments))
  (write-bytes input stdin)
  (close-output-port stdin)
  (define output (port->bytes stdout))
  (define errors (port->bytes stderr))
  (close-input-port stdout) (close-input-port stderr)
  (subprocess-wait child)
  (values (subprocess-status child) output errors))
(define empty-input #"{\"edb_facts\":[],\"rules\":[]}")
(define (padded length)
  (bytes-append empty-input (make-bytes (- length (bytes-length empty-input)) 32)))
(define (check-cli-status arguments input code status)
  (define-values (actual output errors) (run-cli arguments input))
  (check-equal? actual code)
  (check-equal? errors #"")
  (check-true (and (positive? (bytes-length output)) (= (bytes-ref output (sub1 (bytes-length output))) 10)))
  (define value (bytes->jsexpr output))
  (check-equal? (hash-ref value 'status) status)
  value)
(module+ test
  (check-cli-status '("eval") (padded MAX-INPUT-BYTES) 0 "COMPLETE")
  (define over (check-cli-status '("eval") (padded (add1 MAX-INPUT-BYTES)) 2 "INVALID_PROGRAM"))
  (check-equal? (hash-ref over 'facts) null)
  (define multibyte
    (string->bytes/utf-8
     (string-append "{\"edb_facts\":[{\"predicate\":\"" (make-string 131072 #\á) "\",\"args\":[]}],\"rules\":[]}")))
  (check-true (> (bytes-length multibyte) MAX-INPUT-BYTES))
  (check-cli-status '("eval" "--json") multibyte 2 "INVALID_PROGRAM")
  (check-cli-status '("eval") #"\377" 2 "INVALID_PROGRAM")
  (check-cli-status '("eval" "input.json") empty-input 2 "INVALID_PROGRAM")
  (check-cli-status '("demo" "--json" "--json") #"" 2 "INVALID_PROGRAM")
  (check-cli-status '("eval" "--assert") empty-input 2 "INVALID_PROGRAM")
  (for ([command '("replay" "oracle")])
    (check-cli-status (list command) empty-input 0 "COMPLETE"))
  (for ([arguments '(("demo") ("demo" "--assert") ("demo" "--json") ("demo" "--assert" "--json"))])
    (define-values (code output errors) (run-cli arguments #""))
    (check-equal? code 0) (check-equal? errors #"")
    (check-true (positive? (bytes-length output)))
    (when (member "--json" arguments) (check-equal? (hash-ref (bytes->jsexpr output) 'status) "COMPLETE")))
  (define-values (bad-code bad-output bad-errors) (run-cli '("eval") #"{sensitive-invented-boundary-sentinel"))
  (check-equal? bad-code 2)
  (check-false (regexp-match? #rx#"sensitive-invented-boundary-sentinel" (bytes-append bad-output bad-errors)))
  (check-equal? (evaluation-result-status (evaluate-datalog "{not-json")) 'INVALID_PROGRAM)
  (define result (evaluate-datalog (program null (list (fact 'item (vector (string->symbol (make-string 1200 #\q))))))))
  (check-equal? (evaluation-result-status result) 'COMPLETE)
  (define-values (_full frame) (evaluation-result->json-frame result))
  (define size (bytes-length frame))
  (define-values (exact exact-frame) (evaluation-result->json-frame result #:max-bytes size))
  (check-equal? (evaluation-result-status exact) 'COMPLETE)
  (check-equal? exact-frame frame)
  (define-values (limited limited-frame) (evaluation-result->json-frame result #:max-bytes (sub1 size)))
  (check-equal? (evaluation-result-status limited) 'UNKNOWN_BUDGET)
  (check-equal? (evaluation-result-facts limited) null)
  (check-equal? (hash-count (evaluation-result-proofs limited)) 0)
  (check-true (<= (bytes-length limited-frame) (sub1 size)))
  (check-equal? (hash-ref (bytes->jsexpr limited-frame) 'facts) null)
  ;; Small input and modest native relation, but >8MiB of required proof output.
  (define x (var-term 'X)) (define y (var-term 'Y))
  (define huge (string->symbol (make-string 20000 #\z)))
  (define expanded
    (program (list (rule 'expand (literal 'pair (list x y (const-term huge)) #t)
                         (list (literal 'node (list x) #t) (literal 'node (list y) #t))))
             (for/list ([n (in-range 31)]) (fact 'node (vector n)))))
  (define bounded (evaluate-datalog expanded))
  (check-equal? (evaluation-result-status bounded) 'UNKNOWN_BUDGET)
  (check-equal? (evaluation-result-facts bounded) null)
  (check-equal? (hash-count (evaluation-result-proofs bounded)) 0)
  ;; Both output and diagnostic ports fail. This must return the explicit
  ;; infrastructure status even when reporting the first failure also fails.
  (for ([arguments '(("demo") ("eval") ("--help"))])
    (define failed-output
      (make-output-port 'failed-output always-evt
                        (lambda (_buffer _start _end _nonblock? _breakable?)
                          (error 'synthetic-writer "writer unavailable")) void))
    (define failed-error
      (make-output-port 'failed-error always-evt
                        (lambda (_buffer _start _end _nonblock? _breakable?)
                          (error 'synthetic-diagnostic "diagnostic unavailable")) void))
    (check-equal?
     (parameterize ([current-input-port (open-input-bytes empty-input)]
                    [current-output-port failed-output]
                    [current-error-port failed-error])
       (cli:main arguments))
     3)))
